{
  "expo": {
    "name": "멀어서",
    "slug": "meoreoseo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meoreoseo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.meoreoseo.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#3B5BDB"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "MeoreoseoAllInOneWidget",
              "displayName": "멀어서 위젯",
              "description": "할 일, 일정, 습관, 메모, 가계부를 홈 화면에서 모두 전환하고 바로 기록합니다.",
              "android": {
                "minWidth": 250,
                "minHeight": 180,
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/meoreoseo-widgets.tsx"
              }
            }
          ]
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "97f23e36-20a4-4c00-b17e-925cd69984d0"
      }
    },
    "owner": "hwiwonseo"
  }
}
