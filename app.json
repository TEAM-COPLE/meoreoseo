{
  "expo": {
    "name": "멀어서",
    "slug": "meoreoseo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "meoreoseo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "package": "com.meoreoseo.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#3B5BDB"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "MeoreoseoAllInOneWidget",
              "displayName": "멀어서 통합 위젯",
              "description": "할 일, 일정, 습관, 메모, 가계부를 홈 화면에서 모두 전환하고 바로 기록합니다.",
              "android": {
                "minWidth": 250,
                "minHeight": 180,
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/meoreoseo-widgets.tsx"
              }
            },
            {
              "name": "MeoreoseoTodosWidget",
              "displayName": "멀어서 · 할 일",
              "description": "오늘과 진행 중인 할 일을 확인하고 바로 완료 체크·추가합니다.",
              "android": {
                "minWidth": 180,
                "minHeight": 140,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/meoreoseo-widgets.tsx"
              }
            },
            {
              "name": "MeoreoseoCalendarWidget",
              "displayName": "멀어서 · 일정",
              "description": "오늘과 다가오는 일정을 확인하고 새 일정을 바로 추가합니다.",
              "android": {
                "minWidth": 180,
                "minHeight": 140,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/meoreoseo-widgets.tsx"
              }
            },
            {
              "name": "MeoreoseoHabitsWidget",
              "displayName": "멀어서 · 습관",
              "description": "오늘의 습관 실천 여부를 홈 화면에서 바로 체크하고 연속 기록을 확인합니다.",
              "android": {
                "minWidth": 180,
                "minHeight": 140,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/meoreoseo-widgets.tsx"
              }
            },
            {
              "name": "MeoreoseoNotesWidget",
              "displayName": "멀어서 · 메모",
              "description": "고정된 메모와 최근 메모를 확인하고 새 메모를 바로 작성합니다.",
              "android": {
                "minWidth": 180,
                "minHeight": 140,
                "targetCellWidth": 4,
                "targetCellHeight": 2,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/meoreoseo-widgets.tsx"
              }
            },
            {
              "name": "MeoreoseoMoneyWidget",
              "displayName": "멀어서 · 가계부",
              "description": "이번 달 수입·지출·남은 돈을 확인하고 원터치 지출 기록 및 내역을 추가합니다.",
              "android": {
                "minWidth": 250,
                "minHeight": 160,
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "resizeMode": "both",
                "initialLayout": "./src/widgets/meoreoseo-widgets.tsx"
              }
            }
          ]
        }
      ],
      "./plugins/with-meoreoseo-widgets",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "97f23e36-20a4-4c00-b17e-925cd69984d0"
      }
    },
    "owner": "hwiwonseo"
  }
}
